# Travel Planner — configuration template
# Copy to .env and fill in at deploy time. NEVER commit a real .env.
# The app runs with none of these set (dataset pricing + queued email).

# --- AI research model (optional) ---
# Attach an AI model to price trips live via the AiResearchProvider.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# --- Email sending (brochure emails) ---
# Provider options: assistant (default, queued) | smtp | gmail-api
EMAIL_PROVIDER=assistant
EMAIL_FROM=
EMAIL_SMTP_URL=
EMAIL_API_KEY=

# --- Future data APIs (optional) ---
# Live flight / hotel inventory keys, if wired later.
FLIGHTS_API_KEY=
HOTELS_API_KEY=
